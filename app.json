{
  "expo": {
    "name": "depay",
    "slug": "depayapp",
    "scheme": "depay",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/depay.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.olamide00.depay",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/depay.png",
        "backgroundColor": "#ffffff"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "package": "com.olamide00.depay",
      "permissions": [
        "android.permission.GET_ACCOUNTS",
        "android.permission.INTERNET",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/images/depay.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      "expo-web-browser",
      "expo-build-properties",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Tinos-Regular.ttf",
            "./assets/fonts/Tinos-Bold.ttf",
            "./assets/fonts/Tinos-Italic.ttf",
            "./assets/fonts/Tinos-BoldItalic.ttf"
          ]
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Depay to use Face ID to log you in."
        }
      ],
      "expo-image",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/depay.png",
          "imageWidth": 200,
          "resizeMode": "cover",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "152c014f-3cae-4fc3-b395-7955665a8f07"
      }
    }
  }
}
